# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin dashboard password. Set a strong private value in Vercel Environment Variables.
# Never commit the real password.
ADMIN_PASSWORD="change-me-in-vercel"

# Canonical public origin for stable Dynamic QR URLs / self-loop prevention.
APP_URL="https://qr-helper-two.vercel.app"
# Optional comma-separated aliases; Vercel deployment/branch/production URLs are included automatically.
DYNAMIC_QR_SERVICE_ORIGINS=""
