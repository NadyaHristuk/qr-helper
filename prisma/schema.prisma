generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Строка подключения берётся из переменной окружения DATABASE_URL.
  // Локально — в файле .env, на Vercel — в настройках проекта.
  // Бесплатный Postgres: neon.tech (см. README, раздел «Деплой»).
  url      = env("DATABASE_URL")
}

model Order {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  // created | paid | in_production | shipped
  status        String   @default("created")
  // standard | individual
  template      String
  // Цена в копейках UAH
  priceKop      Int
  customerName  String
  customerPhone String
  city          String
  npOffice      String
  // JSON-массив наклеек: [{ type, value }]
  itemsJson     String
}
