generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // created | confirmed | in_production | ready | shipped | completed | cancelled
  status String @default("created")

  // standard | individual
  template String
  // Demo price in kopecks until commercial pricing is approved.
  priceKop Int

  customerName  String
  customerPhone String
  city          String
  npOffice      String
  customerNote  String @default("")

  // nova_poshta | pickup | courier
  deliveryMethod String @default("nova_poshta")
  // manager | online
  paymentMethod  String @default("manager")

  // JSON array of production-ready items: QR payload + design + carrier/size/quantity.
  itemsJson String
}

model DynamicQr {
  id        String   @id @default(cuid())
  slug      String   @unique
  targetUrl String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
